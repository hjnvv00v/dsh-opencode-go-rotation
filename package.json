{
  "name": "dsh-opencode-go-rotation",
  "version": "0.3.0",
  "description": "OpenCode Go key rotation and active-key usage for DeepSeek Harness",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@earendil-works/pi-ai": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer"],
      "platform": "web"
    }
  }
}
